{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gradavia-web",
  "account_id": "aa772cd6962f92be034156b7855f6d62",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_names": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "gradavia-web" },
    { "binding": "GRADAVIA_API", "service": "gradavia-api" },
  ],
  "vars": {
    "GRADAVIA_API_TRANSPORT": "service-binding",
  },
  "routes": [
    {
      "pattern": "gradavia.com",
      "custom_domain": true,
      "zone_id": "ecced0ef0eb47a53c3377130ff87820e",
    },
    {
      "pattern": "www.gradavia.com",
      "custom_domain": true,
      "zone_id": "ecced0ef0eb47a53c3377130ff87820e",
    },
  ],
}
