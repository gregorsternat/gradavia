{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gradavia-api",
  "account_id": "aa772cd6962f92be034156b7855f6d62",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
  },
  "containers": [
    {
      "class_name": "GradaviaApi",
      "image": "../../Dockerfile.api",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 1,
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "API_CONTAINER", "class_name": "GradaviaApi" }],
  },
  "exports": {
    "GradaviaApi": { "type": "durable-object", "storage": "sqlite" },
  },
  "secrets": {
    "required": ["DATABASE_URL"],
  },
}
