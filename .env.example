# Copy to .env.local. Never use production credentials for development or tests.
# Pooled Neon URL for the Next.js HTTP driver.
DATABASE_URL=
# Direct URL for the Rust diagnostic and Drizzle migrations.
DATABASE_URL_UNPOOLED=

# Each checkout may use its own web port. Artifacts are relative to that checkout.
PORT=3000
ARTIFACTS_DIR=.artifacts

# Only used by `just test-db`; must address a disposable loopback database.
# TEST_DATABASE_URL=postgresql://orvio:orvio@127.0.0.1:5432/orvio_test
