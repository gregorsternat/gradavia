# Copy to .env.local. Never use production credentials for development or tests.
# Pooled Neon URL for the Rust API (SQLx) and the read-only connectivity check.
DATABASE_URL=
# Direct URL for the Rust diagnostic and Drizzle migrations.
DATABASE_URL_UNPOOLED=

# Each checkout may use its own web port. Artifacts are relative to that checkout.
PORT=3000
API_BIND=127.0.0.1:3002
# Needed when running Next.js independently with `just dev-web`.
# `just dev` derives the local origin from the API listener.
GRADAVIA_API_URL=http://127.0.0.1:3002
ARTIFACTS_DIR=.artifacts
RAW_DATA_DIR=.data/raw

# Optional for database and browser tests; must address a disposable loopback database.
# TEST_DATABASE_URL=postgresql://gradavia:gradavia@127.0.0.1:5432/gradavia_test
